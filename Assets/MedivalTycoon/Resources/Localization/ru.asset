  - ID: action.clear_beer
    Text: "\u0423\u0431\u0440\u0430\u0442\u044c\n\u043f\u0438\u0432\u043e"
  - ID: action.pour_beer
    Text: "\u0421\u043e\u0437\u0434\u0430\u0442\u044c\n\u043f\u0438\u0432\u043e"
  - ID: action.deposit
    Text: "\u0421\u0434\u0430\u0442\u044c\n\u0437\u043e\u043b\u043e\u0442\u043e"
  - ID: action.barrels
    Text: "\u041f\u043e\u043b\u0443\u0447\u0438\u0442\u044c\n\u0431\u043e\u0447\u043a\u0438"
  - ID: action.next
    Text: "\u0414\u0430\u043b\u0435\u0435"
  - ID: action.exit
    Text: "\u0412\u044b\u0445\u043e\u0434"
  - ID: victory.title
    Text: "\u0423\u0440\u043e\u0432\u0435\u043d\u044c \u043f\u0440\u043e\u0439\u0434\u0435\u043d!"
  - ID: victory.reward
    Text: "\u041f\u043e\u043b\u0443\u0447\u0435\u043d\u043e \u043c\u043e\u043d\u0435\u0442: +{0}"
  - ID: victory.result
    Text: "\u0420\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442: {0} \u0438\u0437 3\n\u0411\u0430\u043b\u0430\u043d\u0441: {1}"
  - ID: seat.beer
    Text: "\u041f\u0438\u0432\u043e: {0}"
  - ID: ad.reward
    Text: "\u0420\u0435\u043a\u043b\u0430\u043c\u0430: +{0} \u0441\u0435\u043a."
  - ID: ad.retry
    Text: "\u0420\u0435\u043a\u043b\u0430\u043c\u0430 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430. \u041f\u043e\u0432\u0442\u043e\u0440\u0438\u0442\u044c: +{0} \u0441\u0435\u043a."
  - ID: exit.title
    Text: "\u0412\u044b\u0439\u0442\u0438 \u0432 \u0433\u043b\u0430\u0432\u043d\u043e\u0435 \u043c\u0435\u043d\u044e?"
  - ID: exit.warning
    Text: "\u0412\u044b \u0443\u0432\u0435\u0440\u0435\u043d\u044b, \u0447\u0442\u043e \u0445\u043e\u0442\u0438\u0442\u0435 \u0432\u044b\u0439\u0442\u0438?\n\u041f\u0440\u043e\u0433\u0440\u0435\u0441\u0441 \u0442\u0435\u043a\u0443\u0449\u0435\u0433\u043e \u0443\u0440\u043e\u0432\u043d\u044f \u043d\u0435 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u0441\u044f."
  - ID: common.no
    Text: "\u041d\u0435\u0442"
  - ID: common.yes
    Text: "\u0414\u0430"
  - ID: upgrade.Balance
    Text: "\u041c\u043e\u043d\u0435\u0442\u044b: {0}"
  - ID: upgrade.Buy
    Text: "\u0423\u043b\u0443\u0447\u0448\u0438\u0442\u044c \u00b7 {0}"
  - ID: upgrade.Maximum
    Text: "\u041c\u0430\u043a\u0441\u0438\u043c\u0443\u043c"
  - ID: upgrade.WorkerSpeed
    Text: "\u0421\u043a\u043e\u0440\u043e\u0441\u0442\u044c"
  - ID: upgrade.WorkerCapacity
    Text: "\u0412\u043c\u0435\u0441\u0442\u0438\u043c\u043e\u0441\u0442\u044c"
